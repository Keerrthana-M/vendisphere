# VendiSphere Server Environment Configuration (Template)
# Copy to .env and fill in values for your environment.
# NEVER commit the real .env file — it is in .gitignore.

# Server Port (Render sets this automatically)
PORT=5000

# MongoDB Connection String
# Local:  mongodb://127.0.0.1:27017/vendisphere
# Atlas:  mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/vendisphere?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/vendisphere

# JSON Web Token Secret — use a long, random string in production
JWT_SECRET=your_secure_jwt_secret_key_here

# Your deployed Vercel frontend URL — required for CORS in production
# Example: https://vendisphere.vercel.app
CLIENT_URL=

# Set to "production" in cloud deployments
NODE_ENV=development

# Optional: Google Gemini API Key for external AI Shopping Assistant
# Leave empty to use the built-in deterministic rule engine (no key needed)
AI_API_KEY=
