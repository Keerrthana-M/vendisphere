# VendiSphere Server Environment Configuration (Template)
# Copy to .env and configure for your environment

# Server Port
PORT=5000

# MongoDB Connection String (Local MongoDB or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/vendisphere

# JSON Web Token Secret Key (Use a strong random secret in production)
JWT_SECRET=your_secure_jwt_secret_key_here

# Optional: Google Gemini API Key for External AI Shopping Assistant
# If left empty, VendiSphere uses its high-speed local deterministic rule engine
AI_API_KEY=
