# VendiSphere Client Environment Configuration (Template)
# Development: No env file needed — Vite proxy handles /api → localhost:5000
# Production (Vercel): Set VITE_API_URL to your Render backend URL in the Vercel dashboard

# Backend API Base URL — only needed for Vercel production builds
# Example: https://vendisphere-api.onrender.com/api
VITE_API_URL=http://localhost:5000/api
